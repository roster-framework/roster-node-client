{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "runtime_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "agent_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "runtime_limits": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "agent_limits": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}\\/[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "required": [
    "global_limit",
    "runtime_limit",
    "agent_limit"
  ],
  "additionalProperties": false
}
