{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "command_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "member_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        }
      },
      "required": [
        "account_id",
        "member_id"
      ],
      "additionalProperties": false
    },
    "core_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "work_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "command_id",
    "command_digest",
    "actor",
    "core_revision",
    "work_revision",
    "accepted_at",
    "replayed"
  ],
  "additionalProperties": false
}
