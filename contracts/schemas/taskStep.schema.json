{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "member",
        "team",
        "flow",
        "auto",
        "review",
        "parallel"
      ]
    },
    "parallel": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        },
        "members": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              },
              "accept": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                }
              },
              "instruction": {
                "type": "string",
                "maxLength": 10000
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600
              }
            },
            "required": [
              "member_id",
              "accept"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "members"
      ],
      "additionalProperties": false
    },
    "member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "team_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "instruction": {
      "type": "string",
      "maxLength": 10000
    },
    "accept": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "allowed_members": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false
}
