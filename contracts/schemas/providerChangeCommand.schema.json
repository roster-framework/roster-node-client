{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "previous": {
      "type": "object",
      "properties": {
        "runtime_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        }
      },
      "required": [
        "runtime_id",
        "agent_id"
      ],
      "additionalProperties": false
    },
    "next": {
      "type": "object",
      "properties": {
        "runtime_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        }
      },
      "required": [
        "runtime_id",
        "agent_id"
      ],
      "additionalProperties": false
    },
    "binding_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "actor": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "member_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        }
      },
      "required": [
        "account_id",
        "member_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "expected_revision",
    "member_id",
    "previous",
    "next",
    "binding_version",
    "actor"
  ],
  "additionalProperties": false
}
