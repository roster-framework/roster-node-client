{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "roster/0.1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "context": {
      "type": "object",
      "properties": {
        "continuation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "const": "roster-execution-continuation/1"
                },
                "wait_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "parent_execution_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "checkpoint_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "thread_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "question_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "answers": {
                  "minItems": 1,
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "member_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                      },
                      "message_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                      },
                      "sequence": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "member_id",
                      "message_id",
                      "sequence",
                      "digest"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "protocol",
                "wait_id",
                "parent_execution_id",
                "checkpoint_digest",
                "thread_id",
                "question_id",
                "answers"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "const": "roster-execution-continuation/2"
                },
                "wait_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "parent_execution_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                },
                "checkpoint_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "children": {
                  "minItems": 1,
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "request_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                      },
                      "record_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "completed",
                          "attention",
                          "cancelled"
                        ]
                      }
                    },
                    "required": [
                      "request_id",
                      "record_id",
                      "digest",
                      "state"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "protocol",
                "wait_id",
                "parent_execution_id",
                "checkpoint_digest",
                "children"
              ],
              "additionalProperties": false
            }
          ]
        },
        "subscription_delivery": {
          "type": "object",
          "properties": {
            "owner_member_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "recipient_member_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "publisher_member_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "signal": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "instruction": {
              "type": "string",
              "maxLength": 10000
            },
            "resource_ids": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              }
            }
          },
          "required": [
            "owner_member_id",
            "recipient_member_id",
            "signal"
          ],
          "additionalProperties": false
        },
        "core_instructions": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 20000
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "updated": {
              "type": "string"
            },
            "updated_by": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "version",
            "updated",
            "updated_by"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "string",
          "maxLength": 20000
        },
        "culture": {
          "type": "string",
          "maxLength": 20000
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "output": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "actor",
              "summary",
              "output"
            ],
            "additionalProperties": false
          }
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "version": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "body"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "request",
        "culture",
        "history",
        "knowledge"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "execution_id",
    "work_id",
    "agent_id",
    "input",
    "context"
  ],
  "additionalProperties": false
}
