{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new",
        "held",
        "accepted-pending",
        "aborted-pending",
        "accepted",
        "aborted"
      ]
    },
    "binding_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "work_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "command_id",
    "fingerprint",
    "stage",
    "binding_version",
    "work_revision"
  ],
  "additionalProperties": false
}
