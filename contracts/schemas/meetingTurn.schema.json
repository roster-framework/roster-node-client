{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "phase": {
      "type": "string",
      "enum": [
        "discussion",
        "minutes",
        "review"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "running",
        "attention",
        "completed",
        "waiting",
        "cancelled"
      ]
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 20000
    },
    "artifact_name": {
      "type": "string",
      "const": "minutes.md"
    },
    "review_action": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes"
      ]
    }
  },
  "required": [
    "index",
    "phase",
    "member_id",
    "state"
  ],
  "additionalProperties": false
}
