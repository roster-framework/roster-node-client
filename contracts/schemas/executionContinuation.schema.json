{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "roster-execution-continuation/1"
        },
        "wait_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "parent_execution_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "checkpoint_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "thread_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "answers": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              },
              "message_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "member_id",
              "message_id",
              "sequence",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocol",
        "wait_id",
        "parent_execution_id",
        "checkpoint_digest",
        "thread_id",
        "question_id",
        "answers"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "roster-execution-continuation/2"
        },
        "wait_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "parent_execution_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "checkpoint_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "children": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              },
              "record_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "completed",
                  "attention",
                  "cancelled"
                ]
              }
            },
            "required": [
              "request_id",
              "record_id",
              "digest",
              "state"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocol",
        "wait_id",
        "parent_execution_id",
        "checkpoint_digest",
        "children"
      ],
      "additionalProperties": false
    }
  ]
}
