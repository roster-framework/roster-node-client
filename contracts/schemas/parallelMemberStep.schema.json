{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "accept": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "instruction": {
      "type": "string",
      "maxLength": 10000
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    }
  },
  "required": [
    "member_id",
    "accept"
  ],
  "additionalProperties": false
}
