{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "suspended"
        },
        "suspension": {
          "type": "object",
          "properties": {
            "execution_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "work_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "runtime_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "agent_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "protocol": {
              "type": "string",
              "const": "roster-execution-suspension/1"
            },
            "wait_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "checkpoint_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "execution_id",
            "work_id",
            "runtime_id",
            "agent_id",
            "protocol",
            "wait_id",
            "checkpoint_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "suspension"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "log"
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            },
            "summary": {
              "type": "string",
              "maxLength": 20000
            },
            "output": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "events": {
              "default": [],
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
                  },
                  "data": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type",
                  "data"
                ],
                "additionalProperties": false
              }
            },
            "artifacts": {
              "default": [],
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.-]{1,120}$"
                  },
                  "mime": {
                    "type": "string",
                    "enum": [
                      "text/plain",
                      "text/markdown",
                      "application/json"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 100000
                  }
                },
                "required": [
                  "name",
                  "mime",
                  "content"
                ],
                "additionalProperties": false
              }
            },
            "metrics": {
              "default": {},
              "type": "object",
              "properties": {
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "summary",
            "output",
            "events",
            "artifacts",
            "metrics"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "observation"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
