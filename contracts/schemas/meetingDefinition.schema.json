{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "participants": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
          },
          "accept": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
            }
          }
        },
        "required": [
          "member_id"
        ],
        "additionalProperties": false
      }
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "recorder": {
      "type": "object",
      "properties": {
        "member_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
        },
        "accept": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
          }
        }
      },
      "required": [
        "member_id"
      ],
      "additionalProperties": false
    },
    "reviewer_member_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    }
  },
  "required": [
    "version",
    "participants",
    "rounds",
    "recorder"
  ],
  "additionalProperties": false
}
