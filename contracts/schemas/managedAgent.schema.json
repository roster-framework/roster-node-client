{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool_approval": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "all",
            "selected"
          ]
        },
        "tools": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "mode",
        "tools"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "echo",
        "llm"
      ]
    },
    "version": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "engine": {
      "type": "string",
      "enum": [
        "langgraph-node",
        "langgraph-python",
        "crewai-python"
      ]
    },
    "model_parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "provider": {
      "default": "openai-compatible",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "instructions": {
      "default": "",
      "type": "string",
      "maxLength": 20000
    },
    "model": {
      "default": "",
      "type": "string",
      "maxLength": 300
    },
    "credential_env": {
      "default": "OPENAI_API_KEY",
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9_]*|)$"
    },
    "base_url": {
      "default": "https://api.openai.com/v1",
      "type": "string",
      "format": "uri"
    },
    "statuses": {
      "default": [
        "success",
        "needs_help"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "mcp_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,99}$"
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "kind",
    "version",
    "provider",
    "instructions",
    "model",
    "credential_env",
    "base_url",
    "statuses",
    "events",
    "mcp_ids",
    "skills",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
